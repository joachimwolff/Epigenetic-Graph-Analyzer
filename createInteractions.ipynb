   "source": [
    "pyrange_promoter = pr.read_bed(path_promoter)\n",
    "pyrange_enhancer = pr.read_bed(path_enhancer)\n",
    "pd_interactions = pd.read_table(path_interactions, header=None, sep='\\t|,', compression='gzip')\n",
    "pd_interactions.columns = [\"Chromosome\", \"Start\", \"End\", \"Chromosome_OE\", \"Start_OE\", \"End_OE\", \"interactions\"]\n",
    "pyrange_interactions = pr.PyRanges(pd_interactions)\n",
    "\n",
    "# match promoter locations with bait locations\n",
    "pyrange_interactions_promoters = pyrange_interactions.join(pyrange_promoter)\n",
    "\n",
    "# rename columns to match joining scheme on Chromosome, Start, End columns of pyranges\n",
    "pyrange_interactions_promoters.columns = [\"Chromosome_Bait\", \"Start_Bait\", \"End_Bait\", \"Chromosome\", \"Start\", \"End\", \"interactions\", \"Start_Promoter\", \"End_Promoter\", \"Name_Promoter\", \"Score_Promoter\", \"Strand_Promoter\", \"ThickStart_Promoter\", \"ThickEnd_Promoter\"]\n",
    "\n",
    "# match enhancer locations with OE locations and get only columns of interest\n",
    "pyrange_interactions_promoters_enhancer = pyrange_interactions_promoters.join(pyrange_enhancer)\n",
    "OE_enhancer = pyrange_interactions_promoters_enhancer[[\"Chromosome_Bait\", \"Start_Bait\", \"End_Bait\", \"Chromosome\", \"Start\", \"End\", \"interactions\", \"Start_Promoter\", \"End_Promoter\", \"Name_Promoter\", \"Start_b\", \"End_b\"]]\n",
    "\n",
    "# match promoter locations with OE locations and get only columns of interest\n",
    "pyrange_interactions_promoters_bait_promoters_OE = pyrange_interactions_promoters.join(pyrange_promoter)\n",
    "OE_promoter = pyrange_interactions_promoters_bait_promoters_OE[[\"Chromosome_Bait\", \"Start_Bait\", \"End_Bait\", \"Chromosome\", \"Start\", \"End\", \"interactions\", \"Start_Promoter\", \"End_Promoter\", \"Name_Promoter\", \"Start_b\", \"End_b\"]]\n",
    "\n",
    "# stack both pyranges of enhancer OE and promoter OE\n",
    "\n",
    "stacked_pyranges = pr.concat([OE_promoter, OE_enhancer])\n",
    "stacked_pyranges.columns = [\"Chromosome\", \"Start_Bait\", \"End_Bait\", \"Chromosome_OE\", \"Start_OE\", \"End_OE\",  \"interactions\", \"Start_Promoter\", \"End_Promoter\", \"Name_Promoter\", \"Start_Enhancer\", \"End_Enhancer\", \"Strand\"]\n",
    "\n",
    "# get unique locations of baits\n",
    "unique_bait_locations = pyrange_promoter.as_df()[['Chromosome', 'Start', 'End']].drop_duplicates().sort_values(by=['Chromosome', 'Start', 'End']).reset_index(drop=True)\n",
    "\n",
    "# get unique locations of OE\n",
    "unique_OE_locations = pd.concat([pyrange_promoter.as_df()[[\"Chromosome\", \"Start\", \"End\"]], pyrange_enhancer.as_df()[[\"Chromosome\", \"Start\", \"End\"]]]).drop_duplicates().reset_index(drop=True)\n",
    "\n",
    "length_baits = len(unique_bait_locations)\n",
    "length_OE = len(unique_OE_locations)\n",
    "matrix = dok_matrix((length_baits, length_OE), dtype=float)\n",
    "\n",
    "# Create a dictionary to map bait locations to matrix indices\n",
    "bait_index_map = {tuple(row): index for index, row in unique_bait_locations.iterrows()}\n",
    "\n",
    "# Create a dictionary to map OE locations to matrix indices\n",
    "OE_index_map = {tuple(row): index for index, row in unique_OE_locations.iterrows()}\n",
    "\n",
    "count = 0\n",
    "for index, row in stacked_pyranges.as_df().iterrows():\n",
    "    bait_location = tuple(row[['Chromosome', 'Start_Promoter', 'End_Promoter']])\n",
    "    OE_location = tuple(row[['Chromosome_OE', 'Start_Enhancer', 'End_Enhancer']])\n",
    "    \n",
    "    try:\n",
    "        bait_index = bait_index_map[bait_location]\n",
    "        OE_index = OE_index_map[OE_location]\n",
    "        \n",
    "        matrix[bait_index, OE_index] = row[\"interactions\"]\n",
    "    except KeyError:\n",
    "        print(bait_location)\n",
    "        print(OE_location)\n",
    "\n",
    "        count += 1\n",
    "\n",
    "        # break\n",
    "\n",
    "print(count)\n",
    "   "
   ]
