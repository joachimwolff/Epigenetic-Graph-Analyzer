    "from scipy.sparse import dok_matrix\n",
    "\n",
    "def get_sparse_matrix_from_pyranges(pyranges_interactions):\n",
    "\n",
    "\n",
    "    length_baits = len(pyranges_interactions.as_df()[['Chromosome', 'Start', 'End']].drop_duplicates())\n",
    "    length_OE = len(pyranges_interactions.as_df()[['Chromosome_OE', 'Start_OE', 'End_OE']].drop_duplicates())\n",
    "\n",
    "    matrix = dok_matrix((length_baits, length_OE), dtype=float)\n",
    "    for index, row in stacked_pyranges.as_df().iterrows():\n",
    "        matching_bait = new_index_df.loc[(new_index_df[\"Chromosome\"] == row[\"Chromosome\"]) & (new_index_df[\"Start\"] == row[\"Start\"]) & (new_index_df[\"End\"] == row[\"End\"])]\n",
    "        matching_OE = sorted_df.loc[(sorted_df[\"Chromosome_OE\"] == row[\"Chromosome_OE\"]) & (sorted_df[\"Start_OE\"] == row[\"Start_OE\"]) & (sorted_df[\"End_OE\"] == row[\"End_OE\"])]\n",
    "        \n",
    "        if index < 10:\n",
    "            print(matching_bait.index.values[0])\n",
    "\n",
    "            print(matching_OE.index.values[0])\n",
    "       \n",
    "       \n",
    "    return matrix"
   ]
  },
